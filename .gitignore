# 运行数据（含密钥）
/data/
/odb
/bin/
*.tmp
# 本地验证码诊断响应（含账号标识/IP）
/t.json
# 账号审计工具与账号数据（50MB，含明文账号/邮箱），不进仓库
/tools/*
!/tools/perch-register/
/tools/perch-register/__pycache__/
/tools/perch-register/.venv/
# 临时产物记录
/_tmp_artifacts.md
# node / pnpm
node_modules/
package-lock.json
pnpm-lock.yaml
.npm/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
.env

# 压测产物
/artifacts/
/.tmp-tokenharbor/

# Go 构建缓存（在仓库内构建时使用）
/.gocache/
/.gotmp/
/.gomodcache/
/.gopath/

# 分析产物（gocache、反编译/逆向中间产物）
/.analysis/
# 临时素材图（飞行海报）
/*.png
/*.svg
# 本地凭据账本（注册机验收产物），永不入库
.private/
